# Copy to `.env.local` (gitignored) and fill in. Vite exposes VITE_* to the app.
# Keys here are seeded into the OS keyring on startup if that slot is empty;
# a key entered in Settings → AI always wins.

# OpenRouter — powers the default "OpenRouter Free" model (openrouter/free).
# Get one at https://openrouter.ai/keys
VITE_OPENROUTER_API_KEY=
